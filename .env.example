# Copy to .env for local/production secrets (never commit .env).

# Google Analytics (optional)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Social / Organization sameAs (optional, comma-separated profile URLs)
# PUBLIC_TWITTER_SITE=@robruncheat
# PUBLIC_TWITTER_CREATOR=@robruncheat
# PUBLIC_ORG_SAME_AS=https://discord.gg/Vu85F8auQS,https://x.com/robruncheat

# Discord invite override (optional)
# PUBLIC_DISCORD_URL=https://discord.gg/Vu85F8auQS

# IndexNow (post-build ping after deploy) — https://www.indexnow.org/
# INDEXNOW_KEY=your-indexnow-key
# INDEXNOW_HOST=robruncheat.net
