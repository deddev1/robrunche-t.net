---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import QuickStartSection from '../components/QuickStartSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import SeoRelatedLinks from '../components/SeoRelatedLinks.astro';
import { resolvePageSeo } from '../config/seo';
import { organizationSchema, websiteSchema } from '../utils/schema';
const seo = resolvePageSeo('/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    websiteSchema(),
    organizationSchema(),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/hero/menu-visuals-512.webp"
    type="image/webp"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <QuickStartSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
  <div class="mx-auto max-w-6xl px-5 pb-16">
    <SeoRelatedLinks title="Explore Rob Run Cheat pages" />
  </div>
</BaseLayout>
